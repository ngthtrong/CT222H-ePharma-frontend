# Frontend Environment Variables
VITE_API_URL=http://localhost:8081/api/v1
VITE_APP_NAME=E-commerce App
VITE_APP_DESCRIPTION=React E-commerce Application

# OAuth2 Configuration (Optional - handled by backend)
# These are for reference only, actual OAuth2 config is in backend
# VITE_GOOGLE_CLIENT_ID=your_google_client_id
# VITE_FACEBOOK_APP_ID=your_facebook_app_id

# Development/Production indicator
VITE_NODE_ENV=development

# Other optional configurations
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
