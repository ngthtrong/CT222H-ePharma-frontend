{
  "name": "project-front-end",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "docker:build": "docker build -t wellverse-frontend .",
    "docker:run": "docker run -p 5173:5173 wellverse-frontend",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:dev-down": "docker-compose -f docker-compose.dev.yml down",
    "docker:logs": "docker-compose -f docker-compose.dev.yml logs -f frontend",
    "docker:prod": "docker build -f Dockerfile.prod -t wellverse-frontend-prod .",
    "docker:run-prod": "docker run -p 80:80 wellverse-frontend-prod",
    "docker:full": "docker-compose up --build",
    "docker:full-down": "docker-compose down -v",
    "docker:prod-up": "docker-compose -f docker-compose.prod.yml up --build -d",
    "docker:prod-down": "docker-compose -f docker-compose.prod.yml down -v",
    "docker:clean": "docker system prune -f && docker volume prune -f"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "axios": "^1.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "react-slick": "^0.30.3",
    "slick-carousel": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "vite": "^7.0.0"
  }
}
